/*
 * Parser CUP para MiniJava
 * Gramática baseada na especificação do MiniJava
 */

package minijava;

import java_cup.runtime.*;

/* Terminais (tokens) */

// Palavras reservadas
terminal CLASS, PUBLIC, STATIC, VOID, MAIN, STRING;
terminal EXTENDS, RETURN, INT, BOOLEAN;
terminal IF, ELSE, WHILE;
terminal TRUE, FALSE, THIS, NEW, LENGTH;
terminal SYSTEM_OUT_PRINTLN;

// Identificadores e literais
terminal String IDENTIFIER;
terminal Integer INTEGER_LITERAL;

// Operadores
terminal AND, EQ_EQ, NOT_EQ, LEQ, GEQ, LT;
terminal ASSIGN, NOT, PLUS, MINUS, TIMES, DIVIDE;

// Delimitadores
terminal LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET;
terminal DOT, COMMA, SEMICOLON;

// Não-terminais
non terminal Program program;
non terminal MainClass main_class;
non terminal ClassDecl class_decl;
non terminal ClassDeclList class_decl_list;
non terminal VarDecl var_decl;
non terminal VarDeclList var_decl_list;
non terminal MethodDecl method_decl;
non terminal MethodDeclList method_decl_list;
non terminal Type type;
non terminal Statement statement;
non terminal StatementList statement_list;
non terminal Exp exp;
non terminal ExpList exp_list;
non terminal ExpRest exp_rest;
non terminal FormalList formal_list;
non terminal FormalRest formal_rest;

// Precedência de operadores
precedence right ASSIGN;
precedence left AND;
precedence left EQ_EQ, NOT_EQ;
precedence left LT, LEQ, GEQ;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE;
precedence right NOT;
precedence left DOT, LBRACKET;

// Símbolo inicial
start with program;

/* Gramática */

// Programa: classe principal seguida de zero ou mais classes
program ::= 
    main_class:mc class_decl_list:cdl
    {: RESULT = new Program(mc, cdl); :}
    ;

// Classe principal com método main
main_class ::= 
    CLASS IDENTIFIER:name LBRACE PUBLIC STATIC VOID MAIN 
    LPAREN STRING LBRACKET RBRACKET IDENTIFIER:arg RPAREN 
    LBRACE statement:s RBRACE RBRACE
    {: RESULT = new MainClass(name, arg, s); :}
    ;

// Lista de declarações de classe
class_decl_list ::= 
    class_decl:cd class_decl_list:cdl
    {: RESULT = new ClassDeclList(cd, cdl); :}
    | /* vazio */
    {: RESULT = new ClassDeclList(); :}
    ;

// Declaração de classe (com ou sem extends)
class_decl ::= 
    CLASS IDENTIFIER:name LBRACE var_decl_list:vdl method_decl_list:mdl RBRACE
    {: RESULT = new ClassDeclSimple(name, vdl, mdl); :}
    | CLASS IDENTIFIER:name EXTENDS IDENTIFIER:parent 
      LBRACE var_decl_list:vdl method_decl_list:mdl RBRACE
    {: RESULT = new ClassDeclExtends(name, parent, vdl, mdl); :}
    ;

// Lista de declarações de variáveis (pode ser vazia)
var_decl_list ::= 
    var_decl_list:vdl var_decl:vd
    {: RESULT = new VarDeclList(vd, vdl); :}
    | /* vazio */
    {: RESULT = new VarDeclList(); :}
    ;

// Declaração de variável
var_decl ::= 
    type:t IDENTIFIER:name SEMICOLON
    {: RESULT = new VarDecl(t, name); :}
    ;

// Lista de declarações de métodos (pode ser vazia)
method_decl_list ::= 
    method_decl:md method_decl_list:mdl
    {: RESULT = new MethodDeclList(md, mdl); :}
    | /* vazio */
    {: RESULT = new MethodDeclList(); :}
    ;

// Declaração de método
method_decl ::= 
    PUBLIC type:t IDENTIFIER:name LPAREN formal_list:fl RPAREN 
    LBRACE var_decl_list:vdl statement_list:sl RETURN exp:e SEMICOLON RBRACE
    {: RESULT = new MethodDecl(t, name, fl, vdl, sl, e); :}
   ;

// Lista de parâmetros formais (pode ser vazia)
formal_list ::= 
    type:t IDENTIFIER:name formal_rest:fr
    {: RESULT = new FormalList(t, name, fr); :}
    | /* vazio */
    {: RESULT = new FormalList(); :}
    ;

// Resto da lista de parâmetros formais
formal_rest ::= 
    COMMA type:t IDENTIFIER:name formal_rest:fr
    {: RESULT = new FormalRest(t, name, fr); :}
    | /* vazio */
    {: RESULT = new FormalRest(); :}
    ;

// Tipos
type ::= 
    INT LBRACKET RBRACKET
    {: RESULT = new IntArrayType(); :}
    | BOOLEAN
    {: RESULT = new BooleanType(); :}
    | INT
    {: RESULT = new IntegerType(); :}
    | IDENTIFIER:name
    {: RESULT = new IdentifierType(name); :}
    ;

// Lista de statements
statement_list ::= 
    statement:s statement_list:sl
    {: RESULT = new StatementList(s, sl); :}
    | /* vazio */
    {: RESULT = new StatementList(); :}
    ;

// Statements
statement ::= 
    LBRACE statement_list:sl RBRACE
    {: RESULT = new Block(sl); :}
    | IF LPAREN exp:e RPAREN statement:s1 ELSE statement:s2
    {: RESULT = new If(e, s1, s2); :}
    | WHILE LPAREN exp:e RPAREN statement:s
    {: RESULT = new While(e, s); :}
    | SYSTEM_OUT_PRINTLN LPAREN exp:e RPAREN SEMICOLON
    {: RESULT = new Print(e); :}
    | IDENTIFIER:name ASSIGN exp:e SEMICOLON
    {: RESULT = new Assign(name, e); :}
    | IDENTIFIER:name LBRACKET exp:e1 RBRACKET ASSIGN exp:e2 SEMICOLON
    {: RESULT = new ArrayAssign(name, e1, e2); :}
   ;

// Expressões
exp ::= 
    exp:e1 AND exp:e2
    {: RESULT = new And(e1, e2); :}
    | exp:e1 EQ_EQ exp:e2
    {: RESULT = new Equal(e1, e2); :}
    | exp:e1 NOT_EQ exp:e2
    {: RESULT = new NotEqual(e1, e2); :}
    | exp:e1 LT exp:e2
    {: RESULT = new LessThan(e1, e2); :}
    | exp:e1 LEQ exp:e2
    {: RESULT = new LessOrEqual(e1, e2); :}
    | exp:e1 GEQ exp:e2
    {: RESULT = new GreaterOrEqual(e1, e2); :}
    | exp:e1 PLUS exp:e2
    {: RESULT = new Plus(e1, e2); :}
    | exp:e1 MINUS exp:e2
    {: RESULT = new Minus(e1, e2); :}
    | exp:e1 TIMES exp:e2
    {: RESULT = new Times(e1, e2); :}
    | exp:e1 DIVIDE exp:e2
    {: RESULT = new Divide(e1, e2); :}
    | exp:e LBRACKET exp:e2 RBRACKET
    {: RESULT = new ArrayLookup(e, e2); :}
    | exp:e DOT LENGTH
    {: RESULT = new ArrayLength(e); :}
    | exp:e DOT IDENTIFIER:name LPAREN exp_list:el RPAREN
    {: RESULT = new Call(e, name, el); :}
    | INTEGER_LITERAL:i
    {: RESULT = new IntegerLiteral(i); :}
    | TRUE
    {: RESULT = new True(); :}
    | FALSE
    {: RESULT = new False(); :}
    | IDENTIFIER:name
    {: RESULT = new IdentifierExp(name); :}
    | THIS
    {: RESULT = new This(); :}
    | NEW INT LBRACKET exp:e RBRACKET
    {: RESULT = new NewArray(e); :}
    | NEW IDENTIFIER:name LPAREN RPAREN
    {: RESULT = new NewObject(name); :}
    | NOT exp:e
    {: RESULT = new Not(e); :}
    | LPAREN exp:e RPAREN
    {: RESULT = e; :}
   ;

// Lista de expressões (argumentos)
exp_list ::= 
    exp:e exp_rest:er
    {: RESULT = new ExpList(e, er); :}
    | /* vazio */
    {: RESULT = new ExpList(); :}
   ;

// Resto da lista de expressões
exp_rest ::= 
    COMMA exp:e exp_rest:er
    {: RESULT = new ExpRest(e, er); :}
    | /* vazio */
    {: RESULT = new ExpRest(); :}
    ;
